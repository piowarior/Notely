{
  "name": "notely",
  "displayName": "notely",
  "description": "Personal notes inside VS Code",
  "publisher": "Pio-Warior",
  "icon": "media/icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "notely.exportMenu",
        "label": "Export Note..."
      }
    ],
    "commands": [
      {
        "command": "notely.addNote",
        "title": "Add Note",
        "icon": "$(new-file)"
      },
      {
        "command": "notely.addFolder",
        "title": "Add Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "notely.rename",
        "title": "Rename"
      },
      {
        "command": "notely.delete",
        "title": "Delete"
      },
      {
        "command": "notely.open",
        "title": "Open Note"
      },
      {
        "command": "notely.export.md",
        "title": "Export as Markdown (.md)"
      },
      {
        "command": "notely.export.doc",
        "title": "Export as Word (.doc)"
      },
      {
        "command": "notely.export.txt",
        "title": "Export as Text Document (.txt)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "notely",
          "title": "Notely",
          "icon": "media/notely.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "notely.addFolder",
          "when": "view == notelyView",
          "group": "navigation"
        },
        {
          "command": "notely.addNote",
          "when": "view == notelyView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "notely.addNote",
          "when": "view == notelyView && viewItem == folder",
          "group": "1_modification"
        },
        {
          "command": "notely.rename",
          "when": "view == notelyView",
          "group": "2_modification"
        },
        {
          "command": "notely.delete",
          "when": "view == notelyView",
          "group": "3_modification"
        },
        {
          "command": "notely.open",
          "when": "view == notelyView && viewItem == note",
          "group": "1_modification"
        },
        {
          "submenu": "notely.exportMenu",
          "when": "view == notelyView && viewItem == note",
          "group": "4_modification"
        }
      ],
      "notely.exportMenu": [
        {
          "command": "notely.export.md",
          "group": "1_format"
        },
        {
          "command": "notely.export.doc",
          "group": "1_format"
        },
        {
          "command": "notely.export.txt",
          "group": "1_format"
        }
      ]
    },
    "views": {
      "notely": [
        {
          "id": "notelyView",
          "name": "Notes"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.20",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "quill-table-ui": "^1.0.7",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
