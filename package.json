{
  "name": "notely",
  "displayName": "notely",
  "description": "Personal notes inside VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
  "commands": [
    {
      "command": "notely.addNote",
      "title": "Add Note"
    },
    {
      "command": "notely.addFolder",
      "title": "Add Folder"
    }
  ],

  "viewsContainers": {
    "activitybar": [
      {
        "id": "notely",
        "title": "Notely",
        "icon": "media/notely.svg"
      }
    ]
  },

  "menus": {
    "view/title": [
      {
        "command": "notely.addNote",
        "when": "view == notelyView",
        "group": "navigation"
      },
      {
        "command": "notely.addFolder",
        "when": "view == notelyView",
        "group": "navigation"
      }
    ]
  },

  "views": {
    "notely": [
      {
        "id": "notelyView",
        "name": "Notes"
      }
    ]
  }
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
